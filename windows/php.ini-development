[PHP]
engine=On
short_open_tag=Off
precision=14
output_buffering=4096
serialize_precision=-1
expose_php=On
max_execution_time=0
max_input_time=60
memory_limit=512M
error_reporting=E_ALL
display_errors=On
display_startup_errors=On
log_errors=On
variables_order="GPCS"
request_order="GP"
post_max_size=32M
upload_max_filesize=32M
default_charset="UTF-8"
extension_dir="ext"

extension=sqlite3
extension=pdo_sqlite
extension=curl
extension=fileinfo
extension=intl
extension=mbstring
extension=openssl
extension=pdo_pgsql
extension=pgsql
extension=pdo_sqlsrv
extension=sqlsrv
extension=sodium
extension=gd
extension=zip

[Date]
date.timezone=UTC

[Session]
session.use_strict_mode=1
session.cookie_httponly=1
session.cookie_samesite=Lax

[Assertion]
zend.assertions=1

[opcache]
opcache.enable=0
opcache.enable_cli=0
opcache.validate_timestamps=1
opcache.revalidate_freq=0
opcache.save_comments=1
