<service>
  <id>fee-processor-frankenphp</id>
  <name>Fee Processor - FrankenPHP</name>
  <description>FrankenPHP and Laravel Octane service for the fee processor API.</description>

  <executable>%BASE%\frankenphp.exe</executable>
  <arguments>run --config "%BASE%\Caddyfile"</arguments>
  <workingdirectory>C:\fee-processor</workingdirectory>

  <env name="APP_ENV" value="production" />
  <env name="APP_BASE_PATH" value="C:\fee-processor" />
  <env name="APP_PUBLIC_PATH" value="C:\fee-processor\public" />
  <env name="PHPRC" value="C:\Program Files\FrankenPHP\php.ini" />
  <env name="FRANKENPHP_EXT_DIR" value="C:\Program Files\FrankenPHP\ext" />
  <env name="LARAVEL_OCTANE" value="1" />
  <env name="MAX_REQUESTS" value="250" />
  <env name="REQUEST_MAX_EXECUTION_TIME" value="30" />
  <env name="OCTANE_WORKERS" value="2" />
  <env name="OCTANE_ADMIN_PORT" value="2019" />
  <env name="OCTANE_PORT" value="8080" />

  <startmode>Automatic</startmode>
  <stoptimeout>30 sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />

  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
