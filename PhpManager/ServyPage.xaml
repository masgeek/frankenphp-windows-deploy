<UserControl x:Class="PhpManager.ServyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PhpManager">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="Servy (Service Manager)" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Status" Style="{StaticResource SubText}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ServyStatus" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button x:Name="InstallBtn" Content="Install Servy" Style="{StaticResource ActionButton}" Click="Install_Click"/>
                        <Button x:Name="UninstallBtn" Content="Uninstall Servy" Background="#DC2626" Foreground="White"
                                BorderThickness="0" Padding="16,8" Margin="8,0,0,0" Click="Uninstall_Click"/>
                        <Button x:Name="RefreshBtn" Content="Refresh" Background="#D1D5DB" Foreground="#374151"
                                BorderThickness="0" Padding="16,8" Margin="8,0,0,0" Click="Refresh_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SubText}" Margin="0,0,0,8"/>
                    <TextBlock Text="Servy is a lightweight Windows service manager used by FrankenPHP to install, start, stop, and remove services." 
                               Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                    <TextBlock Text="GitHub: https://github.com/nicholasgasior/servy" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <local:StatusBar x:Name="StatusBar"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
