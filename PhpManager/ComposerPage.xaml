<UserControl x:Class="PhpManager.ComposerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PhpManager">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="Composer" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Status" Style="{StaticResource SubText}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="StatusText" Foreground="#1F2937" TextWrapping="Wrap" Text="Checking..."/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="InstallBtn" Content="Install / Update Composer" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="Install_Click"/>
                        <Button x:Name="RefreshBtn" Content="Refresh" Style="{StaticResource SecondaryButton}" Click="Refresh_Click"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Composer is stored as composer.phar plus a composer.bat shim in the PHP folder and added to your user PATH. The shim runs whichever PHP is active."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Composer home and cache" Style="{StaticResource SubText}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="HomeText" Foreground="#1F2937" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="SetHomeBtn" Content="Use a folder next to PHP" Style="{StaticResource SecondaryButton}" Click="SetHome_Click"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Sets COMPOSER_HOME for your user so global packages and the download cache live in one known place. Open a new terminal to pick it up."/>
                </StackPanel>
            </Border>

            <local:StatusBar x:Name="StatusBar"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
