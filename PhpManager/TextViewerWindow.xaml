<Window x:Class="PhpManager.TextViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log" Height="520" Width="860" WindowStartupLocation="CenterOwner" Background="#F3F4F6">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="ContentBox" Grid.Row="0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="12" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

        <WrapPanel Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Right">
            <Button x:Name="RefreshBtn" Content="Refresh" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
        </WrapPanel>
    </Grid>
</Window>
