<Window x:Class="PhpManager.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activity Log" Height="400" Width="700"
        WindowStartupLocation="Manual"
        Background="#F3F4F6"
        Closing="LogWindow_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <TextBlock Text="Activity Log" FontWeight="SemiBold" FontSize="14" Foreground="#1F2937" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ClearBtn" Content="Clear" Background="#D1D5DB" Foreground="#374151"
                            BorderThickness="0" Padding="12,6" FontSize="12" Click="Clear_Click" Margin="0,0,6,0"/>
                    <Button x:Name="CopyBtn" Content="Copy All" Background="#D1D5DB" Foreground="#374151"
                            BorderThickness="0" Padding="12,6" FontSize="12" Click="Copy_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <RichTextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True"
                     Background="#1F2937" Foreground="#D1D5DB" FontFamily="Consolas" FontSize="13"
                     BorderThickness="0" Padding="12,8" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
