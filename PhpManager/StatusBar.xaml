<UserControl x:Class="PhpManager.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ProgressBar x:Name="Spinner" Grid.Column="0" Width="16" Height="16"
                         IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,10,0"
                         Foreground="#89b4fa" Background="Transparent"/>

            <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready"
                       Style="{StaticResource SubText}" TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
