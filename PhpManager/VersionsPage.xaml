<UserControl x:Class="PhpManager.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PhpManager">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="PHP Version Manager" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Installed Versions" Style="{StaticResource SubText}" Margin="0,0,0,8"/>
                    <ListBox x:Name="InstalledList" Background="#313244" Foreground="#cdd6f4" BorderThickness="0"
                             DisplayMemberPath="Display" Height="200"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="RefreshBtn" Content="Refresh" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="Refresh_Click"/>
                        <Button x:Name="SetActiveBtn" Content="Set Active" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="SetActive_Click"/>
                        <Button x:Name="RemoveBtn" Content="Remove" Background="#f38ba8" Click="Remove_Click"/>
                    </WrapPanel>
                    <CheckBox x:Name="SystemPathCheck" Content="Also add to system PATH (requires admin)" Style="{StaticResource DarkCheckBox}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Available Versions" Style="{StaticResource SubText}" Margin="0,0,0,8"/>
                    <ListBox x:Name="AvailableList" Background="#313244" Foreground="#cdd6f4" BorderThickness="0"
                             Height="150"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="RefreshCatalogBtn" Content="Refresh Catalog" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="RefreshCatalog_Click"/>
                        <Button x:Name="InstallBtn" Content="Install Selected" Style="{StaticResource ActionButton}" Click="InstallSelected_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <local:StatusBar x:Name="StatusBar"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
