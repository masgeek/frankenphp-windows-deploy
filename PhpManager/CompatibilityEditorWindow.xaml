<Window x:Class="PhpManager.CompatibilityEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xdebug Compatibility Matrix" Height="600" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="latest: Xdebug release per PHP major.minor. compiler: expected VS number per PHP major.minor. unsupported: PHP ranges with no working Windows build."/>

        <TextBox x:Name="JsonBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="#FFFFFF" Foreground="#1F2937"
                 BorderBrush="#D1D5DB" BorderThickness="1" Padding="10"/>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="Save_Click" IsDefault="True"/>
            <Button Content="Cancel" Background="#D1D5DB" Foreground="#374151"
                    BorderThickness="0" Padding="16,8" Click="Cancel_Click"/>
        </WrapPanel>
    </Grid>
</Window>