<UserControl x:Class="PhpManager.ConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PhpManager">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="PHP Configuration" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="php.ini Source" Style="{StaticResource SubText}" Margin="0,0,0,8"/>
                    <RadioButton x:Name="KeepRadio" Content="Keep existing php.ini" Foreground="#374151" Margin="0,4" IsChecked="True"/>
                    <RadioButton x:Name="DevRadio" Content="Development (visible errors, OPcache off)" Foreground="#374151" Margin="0,4"/>
                    <RadioButton x:Name="ProdRadio" Content="Production (errors hidden, OPcache on)" Foreground="#374151" Margin="0,4"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="ApplyBtn" Content="Apply Configuration" Style="{StaticResource ActionButton}" Click="Apply_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <local:StatusBar x:Name="StatusBar"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
