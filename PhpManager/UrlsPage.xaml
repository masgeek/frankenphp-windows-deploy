<UserControl x:Class="PhpManager.UrlsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PhpManager">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="URL Management" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="All URLs are stored in the local database. Changes take effect immediately." Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <DataGrid x:Name="UrlsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#FFFFFF" Foreground="#1F2937" GridLinesVisibility="None"
                              HeadersVisibility="Column" BorderBrush="#D1D5DB" BorderThickness="1"
                              RowBackground="#FFFFFF" AlternatingRowBackground="#F9FAFB"
                              SelectionMode="Single" SelectionChanged="UrlsGrid_SelectionChanged"
                              CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="120"/>
                            <DataGridTextColumn Header="URL Template" Binding="{Binding UrlTemplate}" Width="*"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200"/>
                            <DataGridTextColumn Header="Default" Binding="{Binding DefaultLabel}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock x:Name="FormTitle" Text="New URL" Style="{StaticResource SubText}" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Category" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CategoryBox" Background="#FFFFFF" Foreground="#1F2937"
                                      BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,6" FontSize="14"
                                      IsEditable="True" Text="" Margin="0,0,0,8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Key" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="KeyBox" Background="#FFFFFF" Foreground="#1F2937"
                                     BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,6" FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="URL Template" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                    <TextBox x:Name="UrlTemplateBox" Background="#FFFFFF" Foreground="#1F2937"
                             BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,6" FontSize="14"/>

                    <TextBlock Text="Description" Style="{StaticResource SubText}" Margin="0,8,0,4"/>
                    <TextBox x:Name="DescriptionBox" Background="#FFFFFF" Foreground="#1F2937"
                             BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,6" FontSize="14"/>

                    <CheckBox x:Name="DefaultCheck" Content="Default URL for this category" Style="{StaticResource DarkCheckBox}" Margin="0,4,0,0"/>

                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="SaveBtn" Content="Save" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="Save_Click"/>
                        <Button x:Name="CancelBtn" Content="Cancel" Background="#D1D5DB" Foreground="#374151"
                                BorderThickness="0" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click"/>
                        <Button x:Name="DeleteBtn" Content="Delete" Background="#DC2626" Foreground="White"
                                BorderThickness="0" Padding="16,8" Margin="0,0,8,0" Click="Delete_Click"
                                Visibility="Collapsed"/>
                        <Button x:Name="TestBtn" Content="Test URL" Background="#0F766E" Foreground="White"
                                BorderThickness="0" Padding="16,8" FontWeight="SemiBold" Click="Test_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Maintenance" Style="{StaticResource SubText}" Margin="0,0,0,8"/>
                    <TextBlock Text="Xdebug Compatibility Matrix" Style="{StaticResource SubText}" Margin="0,12,0,8"/>
                    <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Which Xdebug release works with which PHP version. Stored in the database and editable as JSON."/>
                    <WrapPanel>
                        <Button x:Name="ExportBtn" Content="Export…" Background="#D1D5DB" Foreground="#374151"
                                BorderThickness="0" Padding="16,8" FontWeight="SemiBold" Margin="0,0,8,0" Click="Export_Click"/>
                        <Button x:Name="ImportBtn" Content="Import…" Background="#D1D5DB" Foreground="#374151"
                                BorderThickness="0" Padding="16,8" FontWeight="SemiBold" Margin="0,0,8,0" Click="Import_Click"/>
                        <Button x:Name="CompatEditBtn" Content="Edit Compatibility" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="CompatEdit_Click"/>
                        <Button x:Name="CompatResetBtn" Content="Reset Matrix" Background="#DC2626" Foreground="White"
                                BorderThickness="0" Padding="16,8" FontWeight="SemiBold" Click="CompatReset_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="URL Maintenance" Style="{StaticResource SubText}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button x:Name="TestAllBtn" Content="Test All URLs" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="TestAll_Click"/>
                        <Button x:Name="ResetBtn" Content="Reset URLs to Defaults" Background="#DC2626" Foreground="White"
                                BorderThickness="0" Padding="16,8" FontWeight="SemiBold" Click="Reset_Click"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Export writes a JSON snapshot of every stored URL. Import merges a snapshot from another machine. Reset deletes all custom URLs and restores the shipped defaults without touching the compatibility matrix."/>
                </StackPanel>
            </Border>

            <local:StatusBar x:Name="StatusBar"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
