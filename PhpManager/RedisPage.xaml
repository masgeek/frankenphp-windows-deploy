<UserControl x:Class="PhpManager.RedisPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PhpManager">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="Redis Extension" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Downloads and installs php_redis.dll from windows.php.net" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Version" Style="{StaticResource SubText}" Margin="0,0,0,8"/>
                    <TextBox x:Name="VersionBox" Text="6.3.0" Background="#313244" Foreground="#cdd6f4"
                             BorderThickness="0" Padding="8,6" FontSize="14" Margin="0,0,0,12"/>
                    <TextBlock Text="Extension version. Check https://pecl.php.net/package/redis for latest." Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button x:Name="InstallBtn" Content="Install Redis" Style="{StaticResource ActionButton}" Click="Install_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <local:StatusBar x:Name="StatusBar"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
