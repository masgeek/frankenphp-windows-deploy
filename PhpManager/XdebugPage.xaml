<UserControl x:Class="PhpManager.XdebugPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PhpManager">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="Xdebug Installation Wizard" Style="{StaticResource HeaderText}" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="Detects your PHP build, validates compatibility, downloads the matching Xdebug package, writes the php.ini entry, and verifies the result."/>

            <!-- Step 1: Detect -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Step 1 — Detect environment" Style="{StaticResource HeaderText}" FontSize="15" Margin="0,0,0,8"/>

                    <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Detected automatically from the active PHP version. You can also paste phpinfo() or php -i output to analyse a different build."/>

                    <TextBox x:Name="RawInfoBox" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" Height="110"
                             Background="#FFFFFF" Foreground="#1F2937" FontFamily="Consolas" FontSize="12"
                             BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,6" Margin="0,0,0,8"/>

                    <WrapPanel>
                        <Button x:Name="DetectBtn" Content="Detect from active PHP" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="Detect_Click"/>
                        <Button x:Name="ParseBtn" Content="Analyse pasted output" Background="#D1D5DB" Foreground="#374151"
                                BorderThickness="0" Padding="16,8" FontWeight="SemiBold" Click="Parse_Click"/>
                    </WrapPanel>

                    <Grid x:Name="DetectionPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="PHP version" Foreground="#6B7280" Margin="0,0,12,4"/>
                        <TextBlock x:Name="DetPhpVersion" Grid.Row="0" Grid.Column="1" Foreground="#1F2937" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Thread safety" Foreground="#6B7280" Margin="0,0,12,4"/>
                        <TextBlock x:Name="DetThreadSafety" Grid.Row="1" Grid.Column="1" Foreground="#1F2937" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Architecture" Foreground="#6B7280" Margin="0,0,12,4"/>
                        <TextBlock x:Name="DetArchitecture" Grid.Row="2" Grid.Column="1" Foreground="#1F2937" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Compiler" Foreground="#6B7280" Margin="0,0,12,4"/>
                        <TextBlock x:Name="DetCompiler" Grid.Row="3" Grid.Column="1" Foreground="#1F2937" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Debug build" Foreground="#6B7280" Margin="0,0,12,4"/>
                        <TextBlock x:Name="DetDebug" Grid.Row="4" Grid.Column="1" Foreground="#1F2937" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Config file" Foreground="#6B7280" Margin="0,0,12,4"/>
                        <TextBlock x:Name="DetConfigFile" Grid.Row="5" Grid.Column="1" Foreground="#1F2937" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Extension dir" Foreground="#6B7280" Margin="0,0,12,4"/>
                        <TextBlock x:Name="DetExtensionDir" Grid.Row="6" Grid.Column="1" Foreground="#1F2937" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Xdebug loaded" Foreground="#6B7280" Margin="0,0,12,4"/>
                        <TextBlock x:Name="DetLoaded" Grid.Row="7" Grid.Column="1" Foreground="#1F2937" Margin="0,0,0,4"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Step 2: Validate -->
            <Border Style="{StaticResource CardBorder}" x:Name="ValidateCard" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Step 2 — Compatibility" Style="{StaticResource HeaderText}" FontSize="15" Margin="0,0,0,8"/>
                    <Border x:Name="VerdictBox" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                        <TextBlock x:Name="VerdictText" TextWrapping="Wrap" Foreground="White" FontSize="13"/>
                    </Border>
                    <Grid x:Name="DownloadPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Package" Foreground="#6B7280" Margin="0,0,12,4"/>
                        <TextBlock x:Name="ZipNameText" Grid.Row="0" Grid.Column="1" Foreground="#1F2937" FontFamily="Consolas" FontSize="12" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="DLL" Foreground="#6B7280" Margin="0,0,12,4"/>
                        <TextBlock x:Name="DllNameText" Grid.Row="1" Grid.Column="1" Foreground="#1F2937" FontFamily="Consolas" FontSize="12" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Installed as" Foreground="#6B7280" Margin="0,0,12,4"/>
                        <TextBlock x:Name="CanonicalText" Grid.Row="2" Grid.Column="1" Foreground="#1F2937" FontFamily="Consolas" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Step 3: Install + Configure -->
            <Border Style="{StaticResource CardBorder}" x:Name="ActionCard" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Step 3 — Install and configure" Style="{StaticResource HeaderText}" FontSize="15" Margin="0,0,0,8"/>

                    <TextBlock Text="Xdebug version" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="VersionBox" Grid.Column="0" Text="3.5.3" IsEditable="True"
                                  Background="#FFFFFF" Foreground="#1F2937"
                                  BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,6" FontSize="14"/>
                        <Button x:Name="RefreshVersionsBtn" Grid.Column="1" Content="Fetch versions" Background="#D1D5DB" Foreground="#374151"
                                BorderThickness="0" Padding="12,6" Margin="8,0,0,0" Click="RefreshVersions_Click"/>
                        <Button x:Name="DownloadBtn" Grid.Column="2" Content="Download DLL" Style="{StaticResource ActionButton}"
                                Margin="8,0,0,0" Padding="12,6" Click="Download_Click"/>
                    </Grid>

                    <TextBlock Text="Step 4 — php.ini settings" Style="{StaticResource HeaderText}" FontSize="15" Margin="16,16,0,8"/>

                    <CheckBox x:Name="EnabledCheck" Content="Enable Xdebug (writes zend_extension)"
                              Style="{StaticResource DarkCheckBox}" Checked="Enabled_Changed" Unchecked="Enabled_Changed"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Mode" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ModeBox" SelectedIndex="3" Background="#FFFFFF" Foreground="#1F2937"
                                      BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,6" FontSize="14">
                                <ComboBoxItem Content="off"/>
                                <ComboBoxItem Content="develop"/>
                                <ComboBoxItem Content="debug"/>
                                <ComboBoxItem Content="profile"/>
                                <ComboBoxItem Content="trace"/>
                                <ComboBoxItem Content="coverage"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Start with request" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="StartCombo" SelectedIndex="1" Background="#FFFFFF" Foreground="#1F2937"
                                      BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,6" FontSize="14">
                                <ComboBoxItem Content="yes"/>
                                <ComboBoxItem Content="no"/>
                                <ComboBoxItem Content="trigger"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Client host" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="HostBox" Text="127.0.0.1" Background="#FFFFFF" Foreground="#1F2937"
                                     BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,6" FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Client port" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="PortBox" Text="9003" Background="#FFFFFF" Foreground="#1F2937"
                                     BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,6" FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="IDE key" Style="{StaticResource SubText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="IdeKeyBox" Text="phpstorm" Background="#FFFFFF" Foreground="#1F2937"
                                     BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,6" FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Step 5 — Verify" Style="{StaticResource HeaderText}" FontSize="15" Margin="0,16,0,8"/>
                    <Border x:Name="VerifyBox" CornerRadius="6" Padding="12">
                        <TextBlock x:Name="VerifyText" TextWrapping="Wrap" Foreground="White" FontSize="13"/>
                    </Border>

                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="ApplyBtn" Content="Apply to php.ini" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="Apply_Click"/>
                        <Button x:Name="VerifyBtn" Content="Verify" Background="#D1D5DB" Foreground="#374151"
                                BorderThickness="0" Padding="16,8" FontWeight="SemiBold" Margin="0,0,8,0" Click="Verify_Click"/>
                        <Button x:Name="CopyBtn" Content="Copy ini snippet" Background="#D1D5DB" Foreground="#374151"
                                BorderThickness="0" Padding="16,8" FontWeight="SemiBold" Click="Copy_Click"/>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Restart PHP or the FrankenPHP service after applying so the new zend_extension is picked up."/>
                </StackPanel>
            </Border>

            <local:StatusBar x:Name="StatusBar"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>