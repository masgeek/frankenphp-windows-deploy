<UserControl x:Class="PhpManager.SqlServerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PhpManager">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="SQL Server Drivers" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Downloads and installs php_sqlsrv.dll and php_pdo_sqlsrv.dll from Microsoft" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Driver Version" Style="{StaticResource SubText}" Margin="0,0,0,8"/>
                    <TextBox x:Name="VersionBox" Text="5.13.3" Background="#FFFFFF" Foreground="#1F2937"
                             BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,6" FontSize="14" Margin="0,0,0,12"/>
                    <TextBlock Text="Microsoft SQL Server PHP driver version. Check https://github.com/microsoft/msphpsql/releases for latest." Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button x:Name="InstallBtn" Content="Install SQL Server Drivers" Style="{StaticResource ActionButton}" Click="Install_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <local:StatusBar x:Name="StatusBar"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
