<UserControl x:Class="PhpManager.ExtensionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PhpManager">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="Extension Manager" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Extensions" Style="{StaticResource SubText}" Margin="0,0,0,8"/>
                    <DataGrid x:Name="ExtensionGrid" AutoGenerateColumns="False" Background="#FFFFFF"
                              Foreground="#1F2937" GridLinesVisibility="None" CanUserAddRows="False"
                              HeadersVisibility="Column" RowBackground="#FFFFFF" AlternatingRowBackground="#F9FAFB"
                              BorderBrush="#D1D5DB" BorderThickness="1">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Expander IsExpanded="True" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal" Margin="4,4">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1F2937"/>
                                                                <TextBlock Text="{Binding ItemCount, StringFormat='  ({0})'}" Foreground="#6B7280"/>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="70">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                                <DataGridCheckBoxColumn.EditingElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridCheckBoxColumn.EditingElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="Laravel" Binding="{Binding Laravel}" IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="RefreshBtn" Content="Refresh" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="LoadExtensions_Click"/>
                        <Button x:Name="LaravelBtn" Content="Select Laravel Set" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="SelectLaravel_Click"/>
                        <Button x:Name="SaveBtn" Content="Save Changes" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="SaveExtensions_Click"/>
                        <Button x:Name="VerifyBtn" Content="Verify Loaded" Style="{StaticResource ActionButton}" Click="Verify_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <local:StatusBar x:Name="StatusBar"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
