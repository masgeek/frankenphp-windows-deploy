<UserControl x:Class="PhpManager.ExtensionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PhpManager">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Extension Manager" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Extensions" Style="{StaticResource SubText}" Margin="0,0,0,8"/>

                    <!-- the grid scrolls on its own; the action buttons below stay pinned -->
                    <DataGrid x:Name="ExtensionGrid" Grid.Row="1" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" IsReadOnly="False" AutoGenerateColumns="False" Background="#FFFFFF"
                              Foreground="#1F2937" GridLinesVisibility="None" CanUserAddRows="False"
                              HeadersVisibility="Column" RowBackground="#FFFFFF" AlternatingRowBackground="#F9FAFB"
                              BorderBrush="#D1D5DB" BorderThickness="1">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Expander IsExpanded="True" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal" Margin="4,4">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1F2937"/>
                                                                <TextBlock Text="{Binding ItemCount, StringFormat='  ({0})'}" Foreground="#6B7280"/>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="90" MinWidth="80">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                                <DataGridCheckBoxColumn.EditingElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.EditingElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="100" MinWidth="80"/>
                            <DataGridTextColumn Header="Laravel" Binding="{Binding Laravel}" IsReadOnly="True" Width="100" MinWidth="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="100" MinWidth="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button x:Name="SaveBtn" Content="Save Changes" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="SaveExtensions_Click"/>
                    <Button x:Name="LaravelBtn" Content="Select Laravel Set" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SelectLaravel_Click"/>
                    <Button x:Name="VerifyBtn" Content="Verify Loaded" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Verify_Click"/>
                    <Button x:Name="RefreshBtn" Content="Refresh" Style="{StaticResource SecondaryButton}" Click="LoadExtensions_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <local:StatusBar Grid.Row="2" x:Name="StatusBar"/>
    </Grid>
</UserControl>
