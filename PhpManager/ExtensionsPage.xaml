<UserControl x:Class="PhpManager.ExtensionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PhpManager">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="Extension Manager" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Extensions" Style="{StaticResource SubText}" Margin="0,0,0,8"/>
                    <DataGrid x:Name="ExtensionGrid" AutoGenerateColumns="False" Background="#313244"
                              Foreground="#cdd6f4" GridLinesVisibility="None" CanUserAddRows="False"
                              HeadersVisibility="Column" RowBackground="#181825" AlternatingRowBackground="#1e1e2e">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="60"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="RefreshBtn" Content="Refresh" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="LoadExtensions_Click"/>
                        <Button x:Name="SaveBtn" Content="Save Changes" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="SaveExtensions_Click"/>
                        <Button x:Name="VerifyBtn" Content="Verify Loaded" Style="{StaticResource ActionButton}" Click="Verify_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <local:StatusBar x:Name="StatusBar"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
