<Window x:Class="PhpManager.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare php.ini" Height="520" Width="820" WindowStartupLocation="CenterOwner" Background="#F3F4F6">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Foreground="#1F2937" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <ListBox x:Name="DiffList" Grid.Row="1" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1"
                 FontFamily="Consolas" FontSize="12" DisplayMemberPath="Display"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="4,1"/>
                    <Setter Property="Foreground" Value="#374151"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Added">
                            <Setter Property="Background" Value="#DCFCE7"/>
                            <Setter Property="Foreground" Value="#166534"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Removed">
                            <Setter Property="Background" Value="#FEE2E2"/>
                            <Setter Property="Foreground" Value="#991B1B"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Gap">
                            <Setter Property="Foreground" Value="#9CA3AF"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <WrapPanel Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Right">
            <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
        </WrapPanel>
    </Grid>
</Window>
